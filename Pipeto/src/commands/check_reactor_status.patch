#include <stdio.h>
#include <unistd.h>

void encrypt_message(const char *input, char *output, int shift)
{
    for (int i = 0; input[i] != '\0'; i++) {
        if (input[i] >= 'A' && input[i] <= 'Z') {
            output[i] = ((input[i] - 'A' + shift) % 26) + 'A';
        } else if (input[i] >= 'a' && input[i] <= 'z') {
            output[i] = ((input[i] - 'a' + shift) % 26) + 'a';
        } else {
            output[i] = input[i];
        }
    }
    output[i] = '\0';

}

